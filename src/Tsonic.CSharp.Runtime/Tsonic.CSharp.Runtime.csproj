<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- NuGet Package Properties -->
    <PackageId>Tsonic.CSharp.Runtime</PackageId>
    <Authors>Tsonic Project</Authors>
    <Description>TypeScript language runtime primitives for Tsonic compiler - provides Union types, structural typing, and other TS language features in C#</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tsoniclang/csharp-runtime</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tsoniclang/csharp-runtime.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>typescript;csharp;compiler;runtime;native-aot</PackageTags>

    <!-- Enable NativeAOT compatibility -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)**/*.cs" Exclude="$(MSBuildThisFileDirectory)bin/**;$(MSBuildThisFileDirectory)obj/**" />
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
